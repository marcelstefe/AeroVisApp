<Application x:Class="AeroVisApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AeroVisApp"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="InterFont">pack://application:,,,/res/fonts/#Inter Variable</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
            </Style>

            <!-- Theme colour tokens (light defaults) -->
            <SolidColorBrush x:Key="AppCardBg"         Color="#FEFEFE"/>
            <SolidColorBrush x:Key="AppNavActive"       Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppNavHover"        Color="#efefef"/>
            <SolidColorBrush x:Key="AppNavPressed"      Color="#dcdcdc"/>
            <SolidColorBrush x:Key="AppNavActiveHover"  Color="#d6e2f0"/>
            <SolidColorBrush x:Key="AppSubtleBg"        Color="#F5F5F5"/>
            <SolidColorBrush x:Key="AppSubtleHover"     Color="#E8E8E8"/>
            <SolidColorBrush x:Key="AppNavBtnHover"     Color="#f2f2f2"/>
                            <SolidColorBrush x:Key="AppSidebarValue"    Color="#444444"/>
            <SolidColorBrush x:Key="AppProgressTrack"   Color="#B0C4DE"/>
            <SolidColorBrush x:Key="AppDividerLine"     Color="#D0D0D0"/>
            <SolidColorBrush x:Key="AppTabActive"       Color="#222222"/>
            <SolidColorBrush x:Key="AppNavText"         Color="#1a1a1a"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
